# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables for production.

# Get a free API key at https://resend.com after signing up.
RESEND_API_KEY=

# Where contact form submissions should be delivered.
CONTACT_TO_EMAIL=hollyjohanna.robbins@gmail.com

# The "from" address Resend sends as. hollyjohanna.com is verified in Resend,
# so any address on that domain works here — it is send-only and needs no
# mailbox. Without a verified domain you would have to fall back to Resend's
# shared address: Holly Johanna Art <onboarding@resend.dev>
CONTACT_FROM_EMAIL="Holly Johanna Art <hello@hollyjohanna.com>"
