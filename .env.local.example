# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables for production.

# Get a free API key at https://resend.com after signing up.
RESEND_API_KEY=

# Where contact form submissions should be delivered.
CONTACT_TO_EMAIL=hollyjohanna.robbins@gmail.com

# The "from" address Resend sends as. Until a sending domain is verified in
# Resend, you must use their shared onboarding address below. Once
# art.hollyjohanna.com (or hollyjohanna.com) is verified in Resend, change
# this to something like: Holly Johanna Art <hello@hollyjohanna.com>
CONTACT_FROM_EMAIL="Holly Johanna Art <onboarding@resend.dev>"
